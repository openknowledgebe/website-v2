---
// The one arrow icon used across the site. `dir` points it.
interface Props {
  dir?: "right" | "left" | "down";
  size?: number;
}
const { dir = "right", size = 18 } = Astro.props;
const paths = {
  right: "M5 12h14M13 6l6 6-6 6",
  left: "M19 12H5M11 6l-6 6 6 6",
  down: "M12 5v14M6 13l6 6 6-6",
};
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[dir]}></path></svg>
