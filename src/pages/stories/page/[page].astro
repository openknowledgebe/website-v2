---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import StoryList from "@/components/StoryList.astro";
import Pager from "@/components/Pager.astro";
import { getSortedStories, STORIES_PER_PAGE } from "@/lib/content";

export async function getStaticPaths() {
  const all = await getSortedStories();
  const totalPages = Math.ceil(all.length / STORIES_PER_PAGE);
  const paths = [];
  for (let p = 2; p <= totalPages; p++) {
    paths.push({
      params: { page: String(p) },
      props: {
        pageNum: p,
        totalPages,
        stories: all.slice((p - 1) * STORIES_PER_PAGE, p * STORIES_PER_PAGE),
      },
    });
  }
  return paths;
}

const { pageNum, totalPages, stories } = Astro.props;
---

<SiteLayout
  title={`Stories · Page ${pageNum} · Open Knowledge Belgium`}
  description="News, updates and reflections from the Open Knowledge Belgium community."
  section="stories"
>
  <PageIntro title="Stories" lede={`Page ${pageNum} of ${totalPages}.`} />

  <section class="ok-section tight">
    <div class="wrap">
      <StoryList stories={stories} />
      <Pager page={pageNum} total={totalPages} />
    </div>
  </section>
</SiteLayout>
