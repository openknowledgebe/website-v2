---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import StoryList from "@/components/StoryList.astro";
import Pager from "@/components/Pager.astro";
import { getSortedStories, STORIES_PER_PAGE } from "@/lib/content";

const all = await getSortedStories();
const totalPages = Math.ceil(all.length / STORIES_PER_PAGE);
const firstYear = all.length ? all[all.length - 1].data.date.getFullYear() : 2012;
---

<SiteLayout
  title="Stories · Open Knowledge Belgium"
  description="News, updates and reflections from the Open Knowledge Belgium community since 2012."
  section="stories"
>
  <PageIntro title="Stories" lede={`${all.length} stories from the community, going back to ${firstYear}.`} />

  <section class="ok-section tight">
    <div class="wrap">
      <StoryList stories={all.slice(0, STORIES_PER_PAGE)} />
      <Pager page={1} total={totalPages} />
    </div>
  </section>
</SiteLayout>
