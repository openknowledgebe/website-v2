---
import { getCollection, render } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import Arrow from "@/components/Arrow.astro";
import { formatDate, storyExcerpt } from "@/lib/content";

export async function getStaticPaths() {
  const stories = await getCollection("stories");
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const d = story.data;
// Tags as written by many authors over ten years: drop repeats and housekeeping labels.
const tags = [...new Set(d.tags.map((t) => t.trim().toLowerCase()))].filter((t) => t && t !== "featured");
---

<SiteLayout title={`${d.title} · Open Knowledge Belgium`} description={storyExcerpt(story)} section="stories">
  <article>
    <PageIntro title={d.title} back={{ href: "/stories", label: "All stories" }} />

    <section class="ok-section tight">
      <div class="wrap ok-rail">
        <dl class="ok-facts">
          <dt>Published</dt>
          <dd><time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time></dd>
          {d.author && (
            <>
              <dt>By</dt>
              <dd>{d.author}</dd>
            </>
          )}
          {tags.length > 0 && (
            <>
              <dt>About</dt>
              <dd>{tags.join(", ")}</dd>
            </>
          )}
        </dl>
        <div>
          <div class="ok-article">
            <Content />
          </div>
          <p class="ok-after">
            <a class="arrow-link" href="/stories"><Arrow dir="left" /> All stories</a>
          </p>
        </div>
      </div>
    </section>
  </article>
</SiteLayout>
