---
import { getEntry } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { site } from "@/config/site";

const team = await getEntry("pages", "team");
const t = team!.data as any;

type BoardMember = { name: string; role?: string; photo?: string; linkedin?: string };
const members: BoardMember[] = t.board?.members ?? [];
const values: string[] = t.values_section?.values ?? [];
const initials = (name: string) => {
  const words = name.split(/\s+/).filter(Boolean);
  return ((words[0]?.[0] ?? "?") + (words.length > 1 ? words[words.length - 1][0] : "")).toUpperCase();
};

// Turn the markdown links in the opportunities text into real links.
const escapeHtml = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const opportunitiesHtml = escapeHtml(t.opportunities?.default_text ?? "").replace(
  /\[([^\]]+)\]\(([^)]+)\)/g,
  '<a href="$2">$1</a>',
);
---

<SiteLayout title="Team · Open Knowledge Belgium" description="The people and values behind Open Knowledge Belgium.">
  <PageIntro title="The people" lede="A small board today, and an open invitation to join in." />

  {
    members.length > 0 && (
      <section class="ok-section tight ok-people">
        <div class="wrap">
          <header>
            <h2>{t.board?.heading ?? "Board of Directors"}</h2>
            {t.board?.body && <p>{t.board.body}</p>}
          </header>
          <ul class="board large">
            {members.map((m) => (
              <li>
                {m.photo ? (
                  <img class="portrait" src={m.photo} width="560" height="560" alt="" loading="lazy" decoding="async" />
                ) : (
                  <div class="portrait blank" aria-hidden="true">
                    {initials(m.name)}
                  </div>
                )}
                <h3>{m.name}</h3>
                {m.role && <p>{m.role}</p>}
                {m.linkedin && (
                  <p>
                    <a href={m.linkedin} rel="noopener" aria-label={`${m.name} on LinkedIn`}>
                      LinkedIn
                    </a>
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    values.length > 0 && (
      <section class="ok-section tight">
        <div class="wrap">
          <header>
            <h2>{t.values_section?.heading ?? "Values"}</h2>
          </header>
          <p class="ok-values">{values.join(", ")}.</p>
        </div>
      </section>
    )
  }

  {
    t.volunteers?.featured_image?.image && (
      <figure class="ok-band">
        <img src="/uploads/web/home/volunteers.webp" width="1400" height="933" alt={t.volunteers.featured_image.alt || "Open Knowledge Belgium volunteers"} loading="lazy" decoding="async" />
        <figcaption class="wrap">Volunteers at Open Belgium, 2019</figcaption>
      </figure>
    )
  }

  <section class="ok-section tight">
    <div class="wrap ok-pair">
      <div id="volunteer">
        <h2>{t.volunteers?.heading ?? "Volunteers"}</h2>
        <p>{t.volunteers?.body}</p>
        <a class="btn btn-primary" href={`mailto:${site.teamEmail}?subject=${encodeURIComponent("I want to help")}`}>Email the team</a>
        <p class="address">{site.teamEmail}</p>
      </div>
      <div id="opportunities">
        <h2>{t.opportunities?.heading ?? "Opportunities"}</h2>
        <p set:html={opportunitiesHtml} />
      </div>
    </div>
  </section>
</SiteLayout>
