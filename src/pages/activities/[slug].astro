---
import { getCollection, render } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import IrailMap from "@/components/IrailMap.astro";
import Arrow from "@/components/Arrow.astro";
import { activityImage, logoChipBg, statusLine } from "@/lib/content";

export async function getStaticPaths() {
  const activities = await getCollection("activities");
  return activities.map((activity) => ({
    params: { slug: activity.id },
    props: { activity },
  }));
}

const { activity } = Astro.props;
const { Content } = await render(activity);
const d = activity.data;
const members = d.members ?? [];
const img = activityImage(activity);
// Projects whose servers Open Knowledge Belgium pays for get the donate button first.
const hostedHere = activity.id === "irail";
const socials = d.contact_info?.socials ?? {};
const links = [
  { label: "Twitter / X", href: socials.twitter },
  { label: "Facebook", href: socials.facebook },
  { label: "LinkedIn", href: socials.linkedin },
  { label: "GitHub", href: socials.github },
].filter((l) => l.href);
const hasContact = Boolean(d.contact_info?.email) || links.length > 0;

// Show the revival call on archived projects that are either dead-linked
// (no live external site) or explicitly flagged `revivable: true`.
const dormant = d.status === "past" && (!d.to || d.revivable);
const paused = d.status === "paused";
const organiseHref = `mailto:info@openknowledge.be?subject=${encodeURIComponent(`Organising ${d.name}`)}`;
const reviveHref = `mailto:info@openknowledge.be?subject=${encodeURIComponent(
  `Reviving ${d.name}`,
)}&body=${encodeURIComponent(
  `Hi Open Knowledge Belgium,\n\nI'm interested in picking up "${d.name}". Here's a bit about me and what I have in mind:\n\n`,
)}`;
const memberInitials = (name: string) =>
  name
    .split(" ")
    .map((n) => n[0])
    .slice(0, 2)
    .join("");
---

<SiteLayout title={`${d.name} · Open Knowledge Belgium`} description={d.catchphrase} image={img ?? undefined} section="projects">
  <PageIntro title={d.name} lede={d.catchphrase} back={{ href: "/activities", label: "All projects" }}>
    <div class="ok-id" slot="before">
      {
        d.logo && (
          <span class="chip" style={`background-color:${logoChipBg(activity.id, d.color)}`}>
            <img src={d.logo} alt="" />
          </span>
        )
      }
    </div>
    <p class="meta">{statusLine(activity)}</p>
    {
      (d.to || hostedHere || paused) && (
        <div class="actions">
          {hostedHere && (
            <a class="btn btn-primary" href="/donate">
              Help keep it free
            </a>
          )}
          {paused && (
            <a class="btn btn-primary" href="#organise">
              Help organise it
            </a>
          )}
          {d.to && (
            <a class:list={["btn", hostedHere || paused ? "btn-quiet" : "btn-primary"]} href={d.to} rel="noopener">
              Visit {d.to.replace(/^https?:\/\/(www\.)?/, "").replace(/\/.*$/, "")}
              <Arrow />
            </a>
          )}
        </div>
      )
    }
  </PageIntro>

  {
    activity.id === "irail" ? (
      <figure class="ok-lead wrap">
        <IrailMap />
        <figcaption>The train stations iRail covers, drawn from its open data</figcaption>
      </figure>
    ) : (
      img && (
        <figure class="ok-lead wrap">
          <img src={img} alt={d.featured_image?.alt || ""} />
        </figure>
      )
    )
  }

  <section class="ok-section tight">
    <div class="wrap ok-cols">
      <div>
        <article class="ok-article">
          <Content />
        </article>

        {
          paused && (
            <div class="ok-revive" id="organise">
              <h2>Help bring {d.name} back</h2>
              <p>
                {d.name} is still part of Open Knowledge Belgium, but it needs people to organise it again. If
                that could be you, we are happy to help. Write to info@openknowledge.be.
              </p>
              <a class="btn btn-primary" href={organiseHref}>I'd like to help organise it</a>
            </div>
          )
        }

        {
          dormant && (
            <div class="ok-revive">
              <h2>Want to bring {d.name} back?</h2>
              <p>
                This project is not running any more. If you would like to pick it up or restart it under Open
                Knowledge Belgium, we would love to hear from you at info@openknowledge.be. No strings attached.
              </p>
              <a class="btn btn-primary" href={reviveHref}>I'd like to pick this up</a>
            </div>
          )
        }
      </div>

      {
        (hasContact || members.length > 0) && (
          <aside class="ok-aside">
            {hasContact && (
              <>
                <h2>Get in touch</h2>
                <ul>
                  {d.contact_info?.email && (
                    <li>
                      <a href={`mailto:${d.contact_info.email}`}>{d.contact_info.email}</a>
                    </li>
                  )}
                  {links.map((l) => (
                    <li>
                      <a href={l.href} rel="noopener">
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {members.length > 0 && (
              <>
                <h2>{d.status === "active" || d.status === "paused" ? "People" : "Who was involved"}</h2>
                <ul class="people">
                  {members.map((m) => (
                    <li>
                      {m.picture ? (
                        <img src={m.picture} alt="" loading="lazy" decoding="async" />
                      ) : (
                        <span class="blank" aria-hidden="true">
                          {memberInitials(m.name)}
                        </span>
                      )}
                      <span>
                        <strong>{m.name}</strong>
                        {m.task && <small>{m.task}</small>}
                      </span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </aside>
        )
      }
    </div>
  </section>
</SiteLayout>
