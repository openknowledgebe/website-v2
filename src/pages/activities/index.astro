---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import ProjectTile from "@/components/ProjectTile.astro";
import IrailMap from "@/components/IrailMap.astro";
import Arrow from "@/components/Arrow.astro";
import { getActivitiesByStatus, activityImage } from "@/lib/content";
import { site } from "@/config/site";

const { active, paused, independent, past } = await getActivitiesByStatus();

// Past projects. The ones named here lead, in this order (the first two get the large
// slots); everything else follows alphabetically, photographs before logos.
const lead = ["open-summer-of-code", "equalstreetnames", "openstreetmap-belgium", "open-belgium", "hackyourfuture-belgium"];
const rank = (id: string) => (lead.includes(id) ? lead.indexOf(id) : lead.length);
const ordered = [...past].sort(
  (a, b) =>
    rank(a.id) - rank(b.id) ||
    Number(Boolean(activityImage(b))) - Number(Boolean(activityImage(a))) ||
    a.data.name.localeCompare(b.data.name),
);
const startHref = `mailto:${site.email}?subject=${encodeURIComponent("I have an idea for a project")}`;
---

<SiteLayout
  title="Projects · Open Knowledge Belgium"
  description="The projects and communities that grew under the Open Knowledge Belgium roof: what runs today and what was built since 2012."
  section="projects"
>
  <PageIntro title="Projects" lede="Tools and communities that grew under this roof. Some run here today, others have gone independent." />

  <section class="ok-section tight">
    <div class="wrap">
      <header>
        <h2>Running now</h2>
      </header>
      {
        active.length > 0 ? (
          <ul class="ok-running">
            {active.map((a) => (
              <li>
                <a class="picture" href={`/activities/${a.id}`} tabindex="-1" aria-hidden="true">
                  {activityImage(a) ? (
                    <img src={activityImage(a)!} alt="" loading="lazy" decoding="async" />
                  ) : a.id === "irail" ? (
                    <IrailMap />
                  ) : (
                    a.data.logo && <img class="logo" src={a.data.logo} alt="" />
                  )}
                </a>
                <div>
                  <h3><a href={`/activities/${a.id}`}>{a.data.name}</a></h3>
                  {a.data.catchphrase && <p>{a.data.catchphrase}</p>}
                  <a class="arrow-link" href={`/activities/${a.id}`}>About {a.data.name} <Arrow /></a>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <div class="ok-empty">
            <p>Nothing is running right now. Have an idea? We help open projects get started.</p>
            <a class="btn btn-primary" href={startHref}>Start a project</a>
          </div>
        )
      }
    </div>
  </section>

  {
    paused.length > 0 && (
      <section class="ok-section tight">
        <div class="wrap">
          <header>
            <h2>Looking for organisers</h2>
            <p>Still part of Open Knowledge Belgium, waiting for people to run them again. We are happy to facilitate.</p>
          </header>
          <ul class="ok-running">
            {paused.map((a) => (
              <li>
                <a class="picture" href={`/activities/${a.id}`} tabindex="-1" aria-hidden="true">
                  {activityImage(a) ? (
                    <img src={activityImage(a)!} alt="" loading="lazy" decoding="async" />
                  ) : (
                    a.data.logo && <img class="logo" src={a.data.logo} alt="" />
                  )}
                </a>
                <div>
                  <h3><a href={`/activities/${a.id}`}>{a.data.name}</a></h3>
                  {a.data.catchphrase && <p>{a.data.catchphrase}</p>}
                  <a class="arrow-link" href={`/activities/${a.id}#organise`}>Help organise it <Arrow /></a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    independent.length > 0 && (
      <section class="ok-section ok-made">
        <div class="wrap">
          <header>
            <h2>Now independent</h2>
            <p>We hosted these while they grew. Today they stand on their own, and we are proud of them.</p>
          </header>
          <ul class="ok-mosaic">
            {independent.map((a, i) => (
              <ProjectTile activity={a} size={independent.length === 2 ? (i === 0 ? "wide" : "side") : ""} />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    ordered.length > 0 && (
      <section class="ok-section ok-made">
        <div class="wrap">
          <header>
            <h2>Built since 2012</h2>
            <p>Many of these carry on independently. Some are waiting for someone to pick them up.</p>
          </header>
          <ul class="ok-mosaic">
            {ordered.map((a, i) => <ProjectTile activity={a} size={i === 0 ? "wide" : i === 1 ? "side" : ""} />)}
          </ul>
          <div class="ok-more">
            <p class="muted">Want to start something new?</p>
            <a class="arrow-link" href={startHref}>Tell us your idea <Arrow /></a>
          </div>
        </div>
      </section>
    )
  }
</SiteLayout>
