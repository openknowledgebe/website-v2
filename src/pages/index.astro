---
import { getCollection, getEntry } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";
import IrailMap from "@/components/IrailMap.astro";
import GivePanel from "@/components/GivePanel.astro";
import GiveCase from "@/components/GiveCase.astro";
import Arrow from "@/components/Arrow.astro";
import { activityImage, statusLine } from "@/lib/content";
import stations from "@/data/stations.json";
import { site, donate } from "@/config/site";

const activities = await getCollection("activities");
const byId = new Map(activities.map((a) => [a.id, a]));

// The projects shown as photographs, in this order. `img` overrides the project's own picture.
const tiles: { id: string; alt: string; size: string; img?: string }[] = [
  { id: "equalstreetnames", alt: "Map of Brussels with every street coloured by the gender of the person it is named after", size: "wide" },
  { id: "hackyourfuture-belgium", alt: "HackYourFuture Belgium students talking around a table", size: "side" },
  { id: "openstreetmap-belgium", alt: "The OpenStreetMap Belgium community posing outdoors", size: "" },
  { id: "open-belgium", alt: "The volunteer crew of the Open Belgium 2019 conference on stage", size: "" },
  { id: "open-summer-of-code", img: "/uploads/web/home/osoc18.webp", alt: "Students and coaches of Open Summer of Code cheering in a courtyard", size: "" },
].flatMap((t) => {
  const a = byId.get(t.id);
  const img = t.img ?? (a ? activityImage(a) : null);
  return a && img
    ? [{ ...t, img, name: a.data.name, line: a.data.catchphrase ?? "", state: a.data.status === "independent" ? statusLine(a) : "" }]
    : [];
});

const shown = new Set(["irail", ...tiles.map((t) => t.id)]);
const others = activities.filter((a) => !shown.has(a.id)).sort((a, b) => a.data.name.localeCompare(b.data.name));

// Board members come from the team page content, so there is one place to edit them.
type BoardMember = { name: string; photo?: string; linkedin?: string };
const team = await getEntry("pages", "team");
const board: BoardMember[] = (team?.data as any)?.board?.members ?? [];
const initials = (name: string) => {
  const parts = name.split(/\s+/);
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
};

const description =
  "The non-profit home of iRail and Open Summer of Code, and the place where OpenStreetMap Belgium and HackYourFuture Belgium grew up. Kept open by gifts.";
---

<SiteLayout title={site.name} description={description}>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/uploads/web/home/hero-1400.webp"
    imagesrcset="/uploads/web/home/hero-mobile-1000.webp 1000w, /uploads/web/home/hero-1400.webp 1400w, /uploads/web/home/hero-2400.webp 2400w"
    imagesizes="100vw"
  />

  <section class="ok-open">
    <div class="wrap">
      <h1>{site.tagline}.</h1>
      <div>
        <p class="lede">
          Open Knowledge Belgium is the non-profit home of iRail and Open Summer of Code. OpenStreetMap Belgium and
          HackYourFuture Belgium grew up here. Since 2012.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="#give">Donate</a>
          <a class="arrow-link" href="#live">See what we keep running <Arrow dir="down" /></a>
        </div>
      </div>
    </div>
  </section>

  <figure class="ok-hero">
    <picture>
      <source media="(max-width: 40rem)" srcset="/uploads/web/home/hero-mobile-1000.webp" width="1000" height="667" />
      <img
        src="/uploads/web/home/hero-1400.webp"
        srcset="/uploads/web/home/hero-1400.webp 1400w, /uploads/web/home/hero-2400.webp 2400w"
        sizes="100vw"
        width="2400"
        height="1200"
        alt="About a hundred students and coaches in red, green, yellow and blue T-shirts, seen from above, waving at the camera"
        fetchpriority="high"
      />
    </picture>
    <figcaption class="wrap"><a href="/activities/open-summer-of-code">Open Summer of Code</a>, 2019</figcaption>
  </figure>

  <section class="ok-section ok-live" id="live">
    <div class="wrap">
      <div class="grid">
        <IrailMap />
        <div class="note">
          <h2>iRail opens up Belgian train data.</h2>
          <p>
            Timetables and live departures for all {stations.length} stations, free for anyone to build on. It
            answers about 1.2 million requests a day. Open Knowledge Belgium hosts it.
          </p>
          <div class="actions">
            <a class="btn btn-quiet" href="https://irail.be/" rel="noopener">Visit irail.be <Arrow /></a>
            <a class="arrow-link" href="/activities/irail">About iRail <Arrow /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ok-section ok-made">
    <div class="wrap">
      <header>
        <h2>Also made here</h2>
      </header>
      <ul class="ok-mosaic">
        {
          tiles.map((t) => (
            <li class={t.size}>
              <a href={`/activities/${t.id}`}>
                <div class="frame">
                  <img src={t.img} alt={t.alt} loading="lazy" decoding="async" />
                </div>
                <h3>{t.name}</h3>
                <p>{t.line}</p>
                {t.state && <p class="state">{t.state}</p>}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="ok-more">
        <p class="names muted">
          And{" "}
          {others.map((a, i) => [<a href={`/activities/${a.id}`}>{a.data.name}</a>, i < others.length - 2 ? ", " : i === others.length - 2 ? " and " : "."])}
        </p>
        <a class="arrow-link" href="/activities">All projects <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="ok-section ok-give" id="give">
    <div class="wrap">
      <header>
        <h2>{donate.headline}</h2>
        <GiveCase short />
      </header>
      <GivePanel />
    </div>
  </section>

  <section class="ok-section ok-people">
    <div class="wrap">
      <div class="grid">
        <div class="intro">
          <h2>A new board since September 2026</h2>
          <p>Three people today. We are looking for volunteers.</p>
          <a class="arrow-link" href="/team">Meet the team <Arrow /></a>
        </div>
        <ul class="board">
          {
            board.map((p) => (
              <li>
                {p.photo ? (
                  <img class="portrait" src={p.photo} width="560" height="560" alt="" loading="lazy" decoding="async" />
                ) : (
                  <div class="portrait blank" aria-hidden="true">{initials(p.name)}</div>
                )}
                <h3>{p.linkedin ? <a href={p.linkedin} rel="noopener">{p.name}</a> : p.name}</h3>
                <p>Board</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <figure class="ok-band">
    <img src="/uploads/web/home/working-session.webp" width="1800" height="1200" alt="A full room of students working on laptops at shared tables under strings of bunting" loading="lazy" decoding="async" />
  </figure>
</SiteLayout>
